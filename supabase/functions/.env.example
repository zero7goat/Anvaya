# Settings for the Razorpay Edge Functions (supabase/functions). Copy to supabase/functions/.env
# (ignored by git) and upload with:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref <project ref>
# The key secret and webhook secret stay on the server: never put them in a VITE_ variable.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Sites allowed to start payments (comma-separated); empty allows any
ALLOWED_ORIGINS=""
